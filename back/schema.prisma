datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
    id              String    @id @default(uuid()) @unique
    email           String    @unique
    username        String    @unique
    hashedPassword  String
    createdAt       DateTime  @default(now())
    bingos          Bingo[]
    tiles           Tile[]
    sessionRel      UserSessionRelation[]
    groupRel        UserGroupRelation[]
    authSessions    AuthenticationSession[]
    role            Role?
    createdGroups   Group[]
}

model AuthenticationSession {
    userId              String
    accessToken         String      @unique
    refreshToken        String      @unique
    accessValidUntil    DateTime    @default(now())
    refreshValidUntil   DateTime    @default(now())
    createdAt           DateTime    @default(now())
    user                User        @relation(fields: [userId], references: [id])
}

model Role {
    userId          String  @unique
    roles           Int
    user            User    @relation(fields: [userId], references: [id])
}

model Group {
    id              String    @id @default(uuid()) @unique
    name            String
    creatorId       String
    createdAt       DateTime  @default(now())
    sessions        Session[]
    tiles           Tile[]
    userRel         UserGroupRelation[]
    creator         User      @relation(fields: [creatorId], references: [id])
    invitations     GroupInvitation[]
}

model GroupInvitation {
    id              String    @id @default(uuid()) @unique
    groupId         String
    counter         Int
    createdAt       DateTime  @default(now())
    validity        DateTime  @default(now())
    canceled        Boolean   @default(false)
    group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Session {
    id              String    @id @default(uuid()) @unique
    groupId         String
    flimTitle       String    @db.VarChar(255)
    createdAt       DateTime  @default(now())
    startedAt       DateTime?
    finishedAt      DateTime?
    group           Group     @relation(fields: [groupId], references: [id])
    bingos          Bingo[]
    userRel         UserSessionRelation[]
}

model Tile {
    id              String    @id @default(uuid()) @unique
    groupId         String
    userId          String?
    text            String    @db.VarChar(1000)
    createdAt       DateTime  @default(now())
    group           Group     @relation(fields: [groupId], references: [id])
    user            User?     @relation(fields: [userId], references: [id])
    bingoRel        BingoTileRelation[]
}

model Bingo {
    id              String    @id @default(uuid()) @unique
    userId          String?
    sessionId       String
    validated       Boolean   @default(false)
    user            User?     @relation(fields: [userId], references: [id])
    session         Session   @relation(fields: [sessionId], references: [id])
    tileRel         BingoTileRelation[]
}

model BingoTileRelation {
    bingoId       String
    tileId        String
    position      Int
    checked       Boolean   @default(false)
    bingo         Bingo     @relation(fields: [bingoId], references: [id], onDelete: Cascade)
    tile          Tile      @relation(fields: [tileId], references: [id])

    @@id([bingoId, tileId])
}

model UserGroupRelation {
    userId        String
    groupId       String
    roles         Int       @default(0)
    user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    group         Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([userId, groupId])
}

model UserSessionRelation {
    userId        String
    sessionId     String
    user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

    @@id([userId, sessionId])
}